---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { groupStories } from "../lib/stories.mjs";

const stories = groupStories(await getCollection("stories"));
---
<Layout>
  <h1 class="index-title">Read</h1>
  <ul class="toc">
    {stories.map((s) => (
      <li>
        <a href={`/stories/${s.slug}/`}>{s.readme?.data?.name ?? s.slug}</a>
        <span class="hint">{s.parts.length} {s.parts[0]?.kind === "scene" ? "scenes" : "chapters"}</span>
      </li>
    ))}
  </ul>
</Layout>
