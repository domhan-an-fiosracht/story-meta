---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Dossier from "../../components/Dossier.astro";

export async function getStaticPaths() {
  const entries = await getCollection("places");
  return entries
    .filter((e) => e.id !== "readme")
    .map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}
const { entry } = Astro.props;
---
<Layout title={entry.data?.name ?? entry.id} section="places">
  <Dossier entry={entry} groupBase="/places/" />
</Layout>
