---
import Layout from "../layouts/Layout.astro";
import { mappedPlaces, mappedRoutes } from "../lib/map.mjs";
import { glyphSvg } from "../lib/glyphs.mjs";

const markers = (await mappedPlaces()).map((m) => ({ ...m, svg: glyphSvg(m.glyph) }));
const routes = await mappedRoutes();
---
<Layout title="Map" section="map">
  {markers.length === 0 && (
    <p class="prose">No charted places yet — give a place file <code>map</code> coordinates and it appears here.</p>
  )}
  {markers.length > 0 && (
    <div class="map-wrap">
      <div id="territory"></div>
    </div>
  )}
  <script type="application/json" id="map-data" set:html={JSON.stringify({ markers, routes })} />
  <script>
    import L from "leaflet";
    import "leaflet/dist/leaflet.css";

    const el = document.getElementById("territory");
    const { markers, routes } = JSON.parse(document.getElementById("map-data").textContent);
    if (el && markers.length) {
      const map = L.map(el, { scrollWheelZoom: false, maxZoom: 17, attributionControl: true });
      map.attributionControl.setPrefix("");
      L.tileLayer(
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
        { attribution: "Imagery &copy; Esri &amp; contributors", maxZoom: 17 }
      ).addTo(map);

      const accent = getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() || "#b0885a";
      const soft = getComputedStyle(document.documentElement).getPropertyValue("--ink-soft").trim() || "#9a988f";
      const labeled = [];
      for (const r of routes) {
        const paved = r.kind === "paved";
        const line = L.polyline(r.path, {
          color: paved ? soft : accent,
          weight: paved ? 2 : 2.5,
          opacity: paved ? 0.6 : 0.75,
          dashArray: paved ? null : "2 7",
          lineCap: "round",
        }).addTo(map);
        if (r.label) {
          line.bindTooltip(r.label, {
            permanent: true,
            direction: "center",
            className: `map-route-label map-route-label--${r.kind}`,
          });
          labeled.push(line);
        }
      }
      // A label earns its place only when its road is big enough on screen.
      const updateRouteLabels = () => {
        for (const line of labeled) {
          const b = line.getBounds();
          const p1 = map.latLngToContainerPoint(b.getNorthEast());
          const p2 = map.latLngToContainerPoint(b.getSouthWest());
          const el = line.getTooltip()?.getElement();
          if (el) el.style.display = Math.hypot(p1.x - p2.x, p1.y - p2.y) < 90 ? "none" : "";
        }
      };
      map.on("zoomend moveend", updateRouteLabels);

      const bounds = [];
      for (const m of markers) {
        const icon = L.divIcon({
          className: "map-glyph",
          html: `${m.svg}<span class="map-glyph-label">${m.name}</span>`,
          iconSize: [24, 24],
          iconAnchor: [12, 12],
          popupAnchor: [0, -10],
        });
        L.marker([m.lat, m.lng], { icon, title: m.name })
          .addTo(map)
          .bindPopup(`<a href="${m.href}">${m.name}</a>`);
        bounds.push([m.lat, m.lng]);
      }
      // extra bottom padding: the name labels hang below the icons
      map.fitBounds(bounds, { paddingTopLeft: [40, 40], paddingBottomRight: [40, 75], maxZoom: 15 });
      updateRouteLabels();
    }
  </script>
</Layout>
